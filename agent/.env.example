# ==============================================================================
# 企业数据底座智能问析 Agent 系统 —— 环境变量模板
#
# 用法：
#   cd agent
#   Copy-Item .env.example .env
#   然后按下面标了「必填」的项填入真实值
#
# 说明：
#   1. 本文件只放**模板与默认值**，不要在这里填真实密钥；
#      .env 已被 .gitignore 忽略，真实密钥只写进 .env。
#   2. 所有键的读取入口是 core/config.py 的 Settings 类；
#      本文件的键顺序与 Settings 的字段顺序一致，便于对照。
#   3. 键名大小写不敏感（pydantic-settings 的默认行为）。
#   4. 改完 .env 需要**重启 FastAPI 内核**才会生效。
# ==============================================================================


# ==============================================================================
# 一、大模型配置
# ==============================================================================
# 【必填】DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek 接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称；deepseek-chat（对话）或 deepseek-reasoner（推理）
LLM_MODEL=deepseek-chat

# 采样温度。分析类任务要求数值稳定与可复现，建议 0.0 ~ 0.2
LLM_TEMPERATURE=0.1

# 单次生成最大 token 数
LLM_MAX_TOKENS=4096

# 单次大模型请求超时（秒）
LLM_TIMEOUT=120


# ==============================================================================
# 二、数据库配置
# ==============================================================================
# 连接串示例：
#   MySQL（本项目默认）：
#     mysql+pymysql://root:你的密码@localhost:3306/sqllangchain?charset=utf8mb4
#   PostgreSQL：
#     postgresql+psycopg2://postgres:密码@localhost:5432/sqllangchain
#   SQLite（离线演示，功能受限）：
#     sqlite:///./data/agent.db
#
# 注意：字符集参数 charset=utf8mb4 不能省，否则中文列名/注释可能乱码
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/sqllangchain?charset=utf8mb4

# SQL Agent 的 sql_db_schema 工具向模型展示的样例行数
SQL_SAMPLE_ROWS=3


# ==============================================================================
# 三、发现模式与字段映射（客户接入）
# ==============================================================================
# 客户接入契约：mapping.yaml 的相对路径（相对 agent/）。
# 留空或写 none / off / false / 0 时退回「单表标准模型」，
# 字段说明直接取数据库列的 COMMENT。
#   · 标准底座：mappings/standard_production.mapping.yaml
#   · 客户库  ：mappings/mes_prod_log.mapping.yaml
ANALYSIS_MAPPING=

# 跨客户通用的兜底排除项（逗号分隔）。
# 注意：**客户特有的排除项要写进 mapping.yaml 的 discovery.exclude**，
# 不要写在这里 —— 否则换客户又要改配置。
DISCOVERY_EXCLUDE_TABLES=

# 跨客户通用的排除前缀（逗号分隔）
DISCOVERY_EXCLUDE_PREFIXES=


# ==============================================================================
# 四、SQL 安全
# ==============================================================================
# 第二道防线：是否在每次新建连接时把数据库会话设为只读。
# 第一道防线（tools/sql_guard.py 的 SQL 文本校验）始终生效，不受此项影响。
#   MySQL / MariaDB : SET SESSION TRANSACTION READ ONLY
#   PostgreSQL      : SET SESSION CHARACTERISTICS AS TRANSACTION READ ONLY
#   SQLite          : PRAGMA query_only = ON
DB_READONLY_SESSION=true

# 结果回放取数最多返回多少行，防止大结果撑爆前端
SQL_RESULT_ROW_LIMIT=200


# ==============================================================================
# 五、SQL Agent 循环与工具预算
# ==============================================================================
# 单次提问最多几轮「工具调用 → 观测 → 再决策」
SQL_AGENT_MAX_ITERATIONS=8

# 单次提问最长执行时间（秒）。
# 实测有 94 秒的案例（「找出停机时间最长的 10 台设备」），
# 因此前端必须走 /agent/ask/async + SSE，不要用同步接口。
SQL_AGENT_MAX_EXECUTION_TIME=90

# 写入 system prompt 的 {top_k}，提示模型默认返回的行数上限
SQL_AGENT_TOP_K=50

# 是否打印 LangChain Agent 的中间步骤（排查时打开，评测时关闭）
SQL_AGENT_VERBOSE=true


# ==============================================================================
# 六、Prompt 上下文预算（字符数）
#
# 四段上下文：元数据 / 指标 / 知识 / RAG 示例。
# 各段先按自己的预算裁剪；合计仍超总预算时，按优先级从低到高回收：
#   RAG(40) → 知识(70) → 指标(80) → 元数据(90)
# 即最后才动元数据段（没有它模型就在猜列名）。
# ==============================================================================
# 四段合计上限
PROMPT_TOTAL_BUDGET=8000

# 元数据段：表 / 字段 / 样例值 / 表间关系 / 标准字段口径块
PROMPT_METADATA_BUDGET=3000

# 指标段：业务指标口径 → 真实字段与 SQL 表达式
PROMPT_METRICS_BUDGET=1500

# 知识段：分析主题 / 业务对象 / 指标规则
PROMPT_KNOWLEDGE_BUDGET=1800

# RAG 段：相似问题与历史 SQL 示例
PROMPT_RAG_BUDGET=1500

# 元数据段至少展示几张表（即使与当前问题相关性为 0，也保底展示）
PROMPT_METADATA_MIN_TABLES=3

# 元数据段给相关性最高的几张表附带样例值（样例值最吃预算）
PROMPT_METADATA_SAMPLE_TABLES=2

# 字段映射块（标准字段 ↔ 客户列，含单位换算说明）的字符预算。
# 客户库列名与业务词不对应时，这一块是正确率的关键，因此单独留预算。
# 实测提示：该值偏大会挤占 RAG 段，导致新问题一致率下降，可据此调优。
PROMPT_FIELD_MAP_BUDGET=900

# 单张表最多展示多少个字段，其余提示模型用 sql_db_schema 查看
SQL_MAX_COLUMNS_PER_TABLE=25


# ==============================================================================
# 七、Prompt 段开关（消融实验与降级用）
# ==============================================================================
# RAG 段是否启用；关掉即为评测里的 rag_off 配置
RAG_ENABLED=true

# 指标段是否启用；关掉即为评测里的 metrics_off 配置
PROMPT_METRICS_ENABLED=true


# ==============================================================================
# 八、多轮会话
# ==============================================================================
# 单个会话保留多少轮历史（一问一答为一轮），0 表示关闭多轮
SESSION_MAX_TURNS=6

# 会话存储方式：
#   memory —— 进程内，适合单机演示（默认）
#   file   —— 落盘到 agent/sessions/，进程重启后不丢
SESSION_STORE=memory


# ==============================================================================
# 九、RAG 向量检索
# ==============================================================================
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=rag_dev
MILVUS_COLLECTION_NAME=doc

# 每次检索返回几条相似示例
RAG_TOP_K=3

# 相似度下限（COSINE，越大越相似）；低于该值的示例直接丢弃，
# 避免不相似的示例污染 Prompt。调高更保守，调低召回更多。
RAG_MIN_SCORE=0.45

# 硅基流动（SiliconFlow）嵌入服务
# 【必填】未填写时 RAG 段自动降级为空，其余功能不受影响
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 嵌入模型。注意：换模型会改变向量维度，
# ensure_collection() 会检测到维度不一致并自动重建集合后回灌示例。
#   Qwen/Qwen3-VL-Embedding-8B  -> 4096 维
#   BAAI/bge-m3                 -> 1024 维
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B


# ==============================================================================
# 十、LangSmith 链路追踪（可选）
#
# 说明：本项目代码只把以下四项读进 Settings，**没有**主动调用
# LangSmith SDK；是否真正上报取决于 LangChain 自身对
# LANGCHAIN_TRACING_V2 环境变量的识别。因此这里默认关闭。
# 如需开启，请同时设置 LANGCHAIN_TRACING_V2=true。
# ==============================================================================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-data-agent


# ==============================================================================
# 十一、外部搜索工具（预留，可选）
#
# 说明：当前代码未调用任何联网搜索工具，此项仅为配置预留。
# ==============================================================================
TAVILY_API_KEY=
