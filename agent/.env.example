# =====================
# 大模型配置（DeepSeek 示例）
# 可切换为 Qwen、ChatGLM 等 OpenAI 兼容接口
# =====================

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek 接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称
# DeepSeek 可用 deepseek-chat / deepseek-reasoner
LLM_MODEL=deepseek-chat

# 采样温度，分析类任务建议 0.0 ~ 0.2
LLM_TEMPERATURE=0.1

# 单次生成最大 token 数
LLM_MAX_TOKENS=4096

# 请求超时时间（秒）
LLM_TIMEOUT=60

# =====================
# 数据库配置
# =====================
# SQLite 示例：
# DATABASE_URL=sqlite:///E:/code/Agent/企业数据底座智能问析 Agent 系统/agent/data/agent.db
#
# MySQL 示例（本地测试库名：Intelligent_Production_IIoT）：
# DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/Intelligent_Production_IIoT
#
# PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/agent
DATABASE_URL=sqlite:///./data/agent.db

# SQL Agent 提示词中最多展示多少行样例数据
SQL_SAMPLE_ROWS=3

# =====================
# LangSmith 监控（可选）
# =====================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-data-agent

# =====================
# 外部搜索工具（可选）
# =====================
TAVILY_API_KEY=

# =====================
# Milvus RAG 配置
# =====================
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=rag_dev
MILVUS_COLLECTION_NAME=doc
RAG_TOP_K=3

# SiliconFlow 嵌入模型
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
