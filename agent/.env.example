# =====================
# 大模型配置（DeepSeek 示例）
# 可切换为 Qwen、ChatGLM 等 OpenAI 兼容接口
# =====================

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek 接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称
# DeepSeek 可用 deepseek-chat / deepseek-reasoner
LLM_MODEL=deepseek-chat

# 采样温度，分析类任务建议 0.0 ~ 0.2
LLM_TEMPERATURE=0.1

# 单次生成最大 token 数
LLM_MAX_TOKENS=4096

# 请求超时时间（秒）
LLM_TIMEOUT=120

# =====================
# 数据库配置
# =====================
# SQLite 示例：
# DATABASE_URL=sqlite:///E:/code/Agent/企业数据底座智能问析 Agent 系统/agent/data/agent.db
#
# MySQL 示例（本地测试库名：Intelligent_Production_IIoT）：
# DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/Intelligent_Production_IIoT
#
# PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/agent
DATABASE_URL=sqlite:///./data/agent.db

# SQL Agent 提示词中最多展示多少行样例数据
SQL_SAMPLE_ROWS=3

# =====================
# SQL 安全
# =====================
# SQL 只读校验（tools/sql_guard.py）始终生效；下面这项是第二道防线：
# 在每次新建连接时把数据库会话设为只读（MySQL/PostgreSQL/SQLite 支持）
DB_READONLY_SESSION=true

# 结果回放取数最多返回多少行，防止大结果撑爆前端
SQL_RESULT_ROW_LIMIT=200

# =====================
# SQL Agent 循环与工具预算
# =====================
# 单次提问最多几轮「工具调用 → 观测 → 再决策」
SQL_AGENT_MAX_ITERATIONS=8

# 单次提问最长执行时间（秒）
SQL_AGENT_MAX_EXECUTION_TIME=90

# 提示模型默认返回的行数上限（写入 system prompt 的 top_k）
SQL_AGENT_TOP_K=50

# 是否打印 LangChain Agent 的中间步骤
SQL_AGENT_VERBOSE=true

# =====================
# Prompt 上下文预算（字符数）
# =====================
# 四段（元数据 / 指标 / 知识 / RAG 示例）合计上限，超出后按段优先级回收
PROMPT_TOTAL_BUDGET=8000

# 元数据段：表 / 字段 / 样例值 / 表间关系
PROMPT_METADATA_BUDGET=3000

# 指标段：业务指标口径 -> 字段映射
PROMPT_METRICS_BUDGET=1500

# 知识段：分析主题 / 业务对象 / 指标规则
PROMPT_KNOWLEDGE_BUDGET=1800

# RAG 段：相似问题与 SQL 示例
PROMPT_RAG_BUDGET=1500

# 元数据段至少展示几张表（即使与当前问题相关性为 0）
PROMPT_METADATA_MIN_TABLES=3

# 元数据段给相关性最高的几张表附带样例值
PROMPT_METADATA_SAMPLE_TABLES=2

# 单张表最多展示多少个字段，其余提示模型用 sql_db_schema 查看
SQL_MAX_COLUMNS_PER_TABLE=25

# =====================
# LangSmith 监控（可选）
# =====================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-data-agent

# =====================
# 外部搜索工具（可选）
# =====================
TAVILY_API_KEY=

# =====================
# Milvus RAG 配置
# =====================
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=rag_dev
MILVUS_COLLECTION_NAME=doc
RAG_TOP_K=3

# 相似度下限（COSINE，越大越相似）：低于该值的示例直接丢弃，避免污染 Prompt
RAG_MIN_SCORE=0.45

# SiliconFlow 嵌入模型
# 注意：换模型会改变向量维度，ensure_collection() 会检测到并自动重建集合
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
